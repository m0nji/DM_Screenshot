<Window x:Class="DMShot.Video.VideoPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DMShot.Localization"
        Title="{loc:Tr previewCreateTitle}" Width="720" Height="540" MinWidth="480" MinHeight="380"
        Background="{DynamicResource DmBackground}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

  <DockPanel>
    <!-- ===== Bottom panel: timeline + buttons (pinned to the bottom, ALWAYS visible;
         declared before the fill child so it can never be pushed off-screen) ===== -->
    <Border DockPanel.Dock="Bottom" Margin="16,12,16,16"
            Background="{DynamicResource DmSurface}" CornerRadius="10"
            BorderBrush="{DynamicResource DmBorder}" BorderThickness="1" Padding="16,12">
      <StackPanel>

        <!-- Trim timeline: full-duration track, accent kept-range, two handles,
             playhead line. All math in TrimTimelineMath; drag logic in code-behind. -->
        <Canvas x:Name="Timeline" Height="28" Margin="0,0,0,6" Background="Transparent"
                MouseLeftButtonDown="Timeline_MouseDown" MouseMove="Timeline_MouseMove"
                MouseLeftButtonUp="Timeline_MouseUp" SizeChanged="Timeline_SizeChanged">
          <Border x:Name="TrackBase" Height="6" Canvas.Top="11" CornerRadius="3"
                  Background="#33FFFFFF"/>
          <Rectangle x:Name="TrackRange" Height="6" Canvas.Top="11"
                     Fill="{DynamicResource DmAccent}" Opacity="0.55"/>
          <Rectangle x:Name="PlayheadLine" Width="2" Height="18" Canvas.Top="5"
                     Fill="#E6FFFFFF"/>
          <Border x:Name="HandleStart" Width="8" Height="22" Canvas.Top="3" CornerRadius="3"
                  Background="{DynamicResource DmAccent}" BorderBrush="#59FFFFFF" BorderThickness="1"/>
          <Border x:Name="HandleEnd" Width="8" Height="22" Canvas.Top="3" CornerRadius="3"
                  Background="{DynamicResource DmAccent}" BorderBrush="#59FFFFFF" BorderThickness="1"/>
        </Canvas>

        <!-- Start / End labels under the timeline -->
        <Grid Margin="0,0,0,12">
          <TextBlock FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource DmTextDim}"
                     HorizontalAlignment="Left">
            <Run Text="{loc:Tr videoTrimIn}"/><Run Text=" "/><Run x:Name="TrimStartValue" Text="0.0s"/>
          </TextBlock>
          <TextBlock FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource DmTextDim}"
                     HorizontalAlignment="Right">
            <Run Text="{loc:Tr videoTrimOut}"/><Run Text=" "/><Run x:Name="TrimEndValue" Text="0.0s"/>
          </TextBlock>
        </Grid>

        <!-- Duration + action buttons -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{loc:Tr duration}" Foreground="{DynamicResource DmTextDim}" FontSize="12" Margin="0,0,6,0"/>
            <TextBlock x:Name="DurationLabel" FontSize="12" FontFamily="Consolas"
                       Foreground="{DynamicResource DmText}" Text="0.0 s"/>
            <TextBlock x:Name="EstimatedSizeLabel" Foreground="{DynamicResource DmTextDim}"
                       FontSize="12" Margin="16,0,0,0"/>
            <!-- Rendering feedback (mac parity: spinner + label while the GIF renders) -->
            <TextBlock x:Name="RenderingLabel" Text="{loc:Tr creatingGif}"
                       Foreground="{DynamicResource DmAccent}" FontSize="12"
                       Margin="16,0,0,0" Visibility="Collapsed"/>
          </StackPanel>

          <Button x:Name="DiscardButton" Grid.Column="1" Content="{loc:Tr discard}"
                  MinWidth="80" Height="32"/>
          <!-- spacer via ColumnDefinition Width="8" -->
          <Button x:Name="CreateGifButton" Grid.Column="3" Content="{loc:Tr createGif}"
                  Style="{StaticResource AccentButton}" MinWidth="100" Height="32"/>
        </Grid>

      </StackPanel>
    </Border>

    <!-- ===== Preview image: fills the remaining space above the buttons (last child) ===== -->
    <Border Background="#0D0D10" Margin="16,16,16,0" CornerRadius="6"
            BorderBrush="{DynamicResource DmBorder}" BorderThickness="1">
      <Grid>
        <Image x:Name="Preview" Stretch="Uniform"/>
        <!-- Time pill: elapsed-within-range / range length (mac parity) -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                Background="#8C000000" CornerRadius="9" Padding="8,3">
          <TextBlock x:Name="TimePill" FontSize="11" FontFamily="Consolas"
                     Foreground="White" Text="0.0s / 0.0s"/>
        </Border>
      </Grid>
    </Border>
  </DockPanel>
</Window>
