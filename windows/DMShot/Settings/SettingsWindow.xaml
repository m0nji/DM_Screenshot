<Window x:Class="DMShot.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:DMShot.Settings"
        xmlns:loc="clr-namespace:DMShot.Localization"
        Title="{loc:Tr settingsTitle}" Width="820" Height="640" ResizeMode="CanMinimize" Background="{DynamicResource DmWindowBackground}"
        Icon="/Resources/AppIcon.ico" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="190"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Nav — one grouped surface holding plain rows (macOS Settings). No rule between
         the panes: the two surfaces' own frames already separate them.
         Same 14 px outer inset as the content column (top, bottom, outer edge) and a 14 px
         gap between the columns (6 here + 8 content padding), so the nav frame's top lines
         up with the section title and its bottom with the content frame's bottom. -->
    <Border Grid.Column="0" Margin="14,14,6,14" CornerRadius="12" Background="Transparent"
            BorderBrush="{DynamicResource DmBorder}" BorderThickness="1">
      <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Margin="6"
               SelectionChanged="NavChanged" ItemContainerStyle="{StaticResource NavItem}">
        <ListBoxItem IsSelected="True">
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource SettingsGearGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.8" StrokeLineJoin="Round"/></Canvas></Viewbox>
            <TextBlock Text="{loc:Tr sectionGeneral}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M4,8 L4,5.5 C4,4.7 4.7,4 5.5,4 L8,4 M16,4 L18.5,4 C19.3,4 20,4.7 20,5.5 L20,8 M20,16 L20,18.5 C20,19.3 19.3,20 18.5,20 L16,20 M8,20 L5.5,20 C4.7,20 4,19.3 4,18.5 L4,16 M12,8.5 C13.9,8.5 15.5,10.1 15.5,12 C15.5,13.9 13.9,15.5 12,15.5 C10.1,15.5 8.5,13.9 8.5,12 C8.5,10.1 10.1,8.5 12,8.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
            <TextBlock Text="{loc:Tr sectionCapture}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M12,4 L12,14.5 M7.5,10 L12,14.5 L16.5,10 M4.5,15 L4.5,19.5 L19.5,19.5 L19.5,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
            <TextBlock Text="{loc:Tr sectionSaving}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M3.5,7 L20.5,7 L20.5,17 L3.5,17 Z M6.5,10 L7.5,10 M10,10 L11,10 M13.5,10 L14.5,10 M17,10 L17.5,10 M7,13.5 L17,13.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
            <TextBlock Text="{loc:Tr sectionShortcuts}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M12,3.5 C16.7,3.5 20.5,7.3 20.5,12 C20.5,16.7 16.7,20.5 12,20.5 C7.3,20.5 3.5,16.7 3.5,12 C3.5,7.3 7.3,3.5 12,3.5 Z M3.5,12 L20.5,12 M12,3.5 C9.5,6 8.5,9 8.5,12 C8.5,15 9.5,18 12,20.5 C14.5,18 15.5,15 15.5,12 C15.5,9 14.5,6 12,3.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="1.6"/></Canvas></Viewbox>
            <TextBlock Text="{loc:Tr sectionLanguage}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
          </StackPanel>
        </ListBoxItem>
        <ListBoxItem>
          <StackPanel Orientation="Horizontal">
            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="M19,9 C18,6 15.2,4 12,4 C8.5,4 5.6,6.5 5,10 M5,4 L5,10 L11,10 M5,15 C6,18 8.8,20 12,20 C15.5,20 18.4,17.5 19,14 M19,20 L19,14 L13,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
            <TextBlock Text="{loc:Tr sectionUpdates}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
          </StackPanel>
        </ListBoxItem>
      </ListBox>
    </Border>

    <!-- Content (scrollable so long panes — e.g. Updates with release notes — can reach
         their action buttons). macOS parity: the section title sits above the grouped
         surface (12 px gap); only the rows live inside the frame. The ScrollContentPresenter
         arranges the Grid at least viewport-tall, so the star row stretches the frame down
         to the same bottom inset as the nav. -->
    <ScrollViewer Grid.Column="1" Padding="8,14,14,14" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PaneTitle" Grid.Row="0" FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource DmTextStrong}" Margin="0,0,0,12"/>
        <Border Grid.Row="1" CornerRadius="12" Background="Transparent" Padding="14"
                BorderBrush="{DynamicResource DmBorder}" BorderThickness="1">
          <StackPanel x:Name="Pane"/>
        </Border>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
